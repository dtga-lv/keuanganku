# Postgres / Supabase (gunakan connection string "Transaction pooler" atau direct)
DATABASE_URL=postgres://user:pass@host:5432/postgres
DATABASE_SSL=true

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=ganti-dengan-openssl-rand-base64-32

# Google OAuth (Google Cloud Console > Credentials > OAuth client ID > Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kunci AES-256 (32 byte, base64) untuk mengenkripsi refresh token: openssl rand -base64 32
TOKEN_ENC_KEY=

# OCR: "tesseract" (default) atau "vision"
OCR_ENGINE=tesseract
# Opsional: folder berisi ind.traineddata & eng.traineddata agar tidak mengunduh saat runtime
TESSDATA_PATH=
GOOGLE_VISION_API_KEY=

# Zona waktu untuk tampilan di Google Sheets & agregasi grafik
APP_TZ=Asia/Jakarta
